# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram Bot Token (from @BotFather) - NEVER expose publicly
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Session HMAC Secret for signing short-lived player session tokens
SESSION_SECRET=replace-with-a-strong-random-64-char-hex-secret

# Local Browser Dev Mode (set to "false" in production!)
NEXT_PUBLIC_ENABLE_DEV_AUTH=true
